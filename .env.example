# Server/local worker only. Never prefix these keys with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Actual model availability is checked with npm run setup:providers.
GEMINI_PLANNER_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_VOICE_NAME=Kore
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=ELEVENLABS_VOICE_ID
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_FALLBACK_ENABLED=false
# First prototype: topic-based education, local files, no music.
PIPELINE_MODE=education
PIPELINE_TOPIC=How a hydroelectric power station generates electricity
PIPELINE_AUDIENCE=beginners
PIPELINE_DURATION_SECONDS=60
PIPELINE_FORMAT=landscape
